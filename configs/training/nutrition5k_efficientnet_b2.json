{
  "dataset": "Nutrition5k RGB",
  "architecture": "torchvision-efficientnet-b2",
  "weights": "EfficientNet_B2_Weights.IMAGENET1K_V1",
  "image_size": 288,
  "target_order": ["calories", "protein", "carbohydrates", "fat"],
  "target_units": ["kcal/g", "g/g", "g/g", "g/g"],
  "normalization": {
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "augmentation": {
    "horizontal_flip_probability": 0.5,
    "color_jitter_probability": 0.7,
    "rotation_probability": 0.25,
    "rotation_degrees": 5.0
  },
  "training": {
    "seed": 42,
    "validation_fraction": 0.1,
    "validation_group": "dish_id_utc_day",
    "max_epochs": 50,
    "early_stopping_patience": 8,
    "batch_size": 4,
    "gradient_accumulation_steps": 2,
    "effective_batch_size": 8,
    "num_workers": 0,
    "optimizer": "AdamW",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "loss": "normalized_smooth_l1",
    "smooth_l1_beta": 1.0,
    "scheduler": "ReduceLROnPlateau",
    "scheduler_factor": 0.5,
    "scheduler_patience": 2,
    "minimum_learning_rate": 0.000001,
    "amp_dtype": "auto"
  }
}
